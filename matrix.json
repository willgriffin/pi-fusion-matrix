{
  "providerId": "fusion-matrix",
  "providerName": "Fusion Matrix",
  "defaultFusion": "default-smrt",
  "aliases": {
    "glm": {
      "model": "glm-5.3",
      "providers": [
        "opencode-go",
        "zai"
      ]
    },
    "glm-flash": {
      "model": "glm-5.3-flash",
      "contextWindow": 1000000,
      "maxTokens": 131072,
      "providers": [
        "opencode-go"
      ]
    },
    "kimi": {
      "model": "kimi-k3",
      "contextWindow": 1048576,
      "maxTokens": 131072,
      "providers": [
        "opencode-go",
        {
          "id": "kimi-coding",
          "modelOverride": "k3"
        }
      ]
    },
    "deepseek-flash": {
      "model": "deepseek-v4.1-flash",
      "contextWindow": 1000000,
      "maxTokens": 384000,
      "providers": [
        "opencode-go"
      ]
    },
    "deepseek-pro": {
      "model": "deepseek-v4-pro",
      "providers": [
        "opencode-go"
      ]
    },
    "qwen-max": {
      "model": "qwen3.8-max",
      "providers": [
        "opencode-go"
      ]
    },
    "qwen-flash": {
      "model": "qwen3.8-flash",
      "contextWindow": 1000000,
      "maxTokens": 131072,
      "providers": [
        "opencode-go"
      ]
    },
    "grok": {
      "model": "grok-4.6",
      "providers": [
        "opencode-go"
      ],
      "reasoning": true
    },
    "luna": {
      "model": "gpt-5.6-luna",
      "providers": [
        "opencode-go",
        "openai"
      ],
      "reasoning": true
    },
    "gpt": {
      "model": "gpt-5.6-sol",
      "providers": [
        "openai"
      ]
    }
  },
  "personas": {
    "technical": {
      "prompt": "prompts/technical.md",
      "temperature": 0.5,
      "thinking": "medium"
    },
    "skeptic": {
      "prompt": "prompts/skeptic.md",
      "temperature": 0.8
    },
    "systems": {
      "prompt": "prompts/systems.md",
      "temperature": 0.6
    },
    "judge": {
      "prompt": "prompts/judge.md",
      "temperature": 0.2,
      "output": "json"
    },
    "synth": {
      "prompt": "prompts/synth.md",
      "temperature": 0.5
    },
    "review-synth": {
      "prompt": "prompts/review-synth.md",
      "temperature": 0.3,
      "output": "json"
    },
    "synth-lean": {
      "prompt": "prompts/synth-lean.md",
      "temperature": 0.5,
      "thinking": "medium"
    },
    "merge": {
      "prompt": "prompts/merge.md",
      "temperature": 0.4
    },
    "review-skeptic": {
      "prompt": "prompts/review-skeptic.md",
      "temperature": 0.8,
      "output": "json"
    },
    "review-technical": {
      "prompt": "prompts/review-technical.md",
      "temperature": 0.5,
      "thinking": "medium",
      "output": "json"
    },
    "review-systems": {
      "prompt": "prompts/review-systems.md",
      "temperature": 0.6,
      "output": "json"
    }
  },
  "modes": {
    "single": {
      "stages": [
        {
          "single": "technical",
          "input": "prompt"
        }
      ]
    },
    "pair": {
      "stages": [
        {
          "parallel": [
            "technical",
            "skeptic"
          ],
          "input": "prompt"
        },
        {
          "single": "merge",
          "input": "panel"
        }
      ]
    },
    "pair-judged": {
      "stages": [
        {
          "parallel": [
            "technical",
            "skeptic"
          ],
          "input": "prompt"
        },
        {
          "single": "judge",
          "input": "panel"
        },
        {
          "single": "synth",
          "input": "panel+judge"
        }
      ]
    },
    "lean": {
      "stages": [
        {
          "parallel": [
            "technical",
            "skeptic"
          ],
          "input": "prompt"
        },
        {
          "single": "synth-lean",
          "input": "panel"
        }
      ]
    },
    "committee": {
      "stages": [
        {
          "parallel": [
            "technical",
            "skeptic",
            "systems"
          ],
          "input": "prompt"
        },
        {
          "single": "judge",
          "input": "panel"
        },
        {
          "single": "synth",
          "input": "panel+judge"
        }
      ]
    },
    "committee-merged": {
      "stages": [
        {
          "parallel": [
            "technical",
            "skeptic",
            "systems"
          ],
          "input": "prompt"
        },
        {
          "single": "judge",
          "input": "panel",
          "alsoSynthesize": true
        }
      ]
    },
    "opinion": {
      "stages": [
        {
          "parallel": [
            "technical",
            "skeptic",
            "systems"
          ],
          "input": "prompt"
        },
        {
          "render": "panel"
        }
      ]
    },
    "debate": {
      "stages": [
        {
          "parallel": [
            "technical",
            "skeptic",
            "systems"
          ],
          "input": "prompt",
          "rounds": 3,
          "roundInput": "peers"
        },
        {
          "render": "panel"
        }
      ]
    },
    "committee-cascaded": {
      "stages": [
        {
          "parallel": [
            "technical",
            "skeptic",
            "systems"
          ],
          "input": "prompt"
        },
        {
          "decide": {
            "instructions": "Do the experts agree on a single core recommendation?",
            "criteria": {
              "agrees": "They converge on the same recommendation.",
              "partial": "They overlap but differ on a substantive point.",
              "disagrees": "They recommend different things."
            }
          },
          "input": "panel",
          "sufficientWhen": {
            "choiceIs": [
              "agrees"
            ],
            "minConfidence": 0.85
          }
        },
        {
          "single": "judge",
          "input": "panel"
        },
        {
          "single": "synth",
          "input": "panel+judge"
        }
      ]
    },
    "review-single": {
      "stages": [
        {
          "parallel": [
            "review-skeptic"
          ],
          "input": "prompt"
        },
        {
          "single": "review-synth",
          "input": "panel"
        }
      ]
    },
    "review-committee": {
      "stages": [
        {
          "parallel": [
            "review-technical",
            "review-skeptic",
            "review-systems"
          ],
          "input": "prompt"
        },
        {
          "decide": {
            "instructions": "Do the reviewers agree on the same material findings?",
            "criteria": {
              "agrees": "They converge on the same findings and the same severity.",
              "partial": "They overlap but differ on a substantive finding or its severity.",
              "disagrees": "They report materially different findings."
            }
          },
          "input": "panel",
          "sufficientWhen": {
            "choiceIs": [
              "agrees"
            ],
            "minConfidence": 0.85
          }
        },
        {
          "single": "judge",
          "input": "panel"
        },
        {
          "single": "review-synth",
          "input": "panel+judge"
        }
      ]
    }
  },
  "fusions": {
    "cheap": {
      "name": "Cheap · one flash seat",
      "mode": "single",
      "thinking": {
        "technical": "low"
      },
      "candidates": {
        "technical": [
          "qwen-flash"
        ]
      },
      "fileAgent": false
    },
    "quick": {
      "name": "Quick · deepseek flash",
      "mode": "single",
      "thinking": {
        "technical": "low"
      },
      "candidates": {
        "technical": [
          "deepseek-flash"
        ]
      },
      "fileAgent": false
    },
    "good": {
      "name": "Good · two flash seats + merge",
      "mode": "lean",
      "thinking": {
        "technical": "low",
        "skeptic": "low",
        "synth-lean": "low"
      },
      "candidates": {
        "technical": [
          "deepseek-flash"
        ],
        "skeptic": [
          "glm-flash"
        ],
        "synth-lean": [
          "qwen-flash"
        ]
      },
      "fileAgent": false
    },
    "best": {
      "name": "Best · judged pair",
      "mode": "pair-judged",
      "thinking": {
        "technical": "low",
        "skeptic": "low",
        "judge": "high",
        "synth": "high"
      },
      "candidates": {
        "technical": [
          "deepseek-pro"
        ],
        "skeptic": [
          "glm"
        ],
        "judge": [
          "deepseek-flash"
        ],
        "synth": [
          "glm-flash"
        ]
      },
      "fileAgent": false
    },
    "default-smrt": {
      "name": "Default · routed",
      "mode": "single",
      "thinking": {
        "technical": "low"
      },
      "route": {
        "instructions": "How much work does this request need? Judge the work itself, not how it was phrased, and prefer the cheapest rung that can carry it.",
        "criteria": {
          "cheap": {
            "description": "A lookup, a definition, or a one-line factual answer — no judgement needed.",
            "then": "cheap"
          },
          "quick": {
            "description": "An ordinary question or a small change that needs one careful pass.",
            "then": "quick"
          },
          "good": {
            "description": "Two or three things interact, or the answer is better with a second opinion.",
            "then": "good"
          },
          "best": {
            "description": "Expensive to get wrong: design tradeoffs, correctness-critical work, or several interacting decisions.",
            "then": "best"
          },
          "unsure": {
            "description": "Ambiguous, or missing the context you would need to judge.",
            "then": "quick"
          }
        },
        "sufficientWhen": {
          "minConfidence": 0.4
        }
      },
      "candidates": {
        "technical": [
          "deepseek-flash"
        ]
      },
      "fileAgent": false
    },
    "opinions": {
      "mode": "opinion",
      "candidates": {
        "technical": [
          "kimi"
        ],
        "skeptic": [
          "deepseek-pro"
        ],
        "systems": [
          "glm"
        ]
      },
      "fileAgent": false
    },
    "debate": {
      "mode": "debate",
      "candidates": {
        "technical": [
          "kimi"
        ],
        "skeptic": [
          "deepseek-pro"
        ],
        "systems": [
          "glm"
        ]
      },
      "fileAgent": false
    },
    "review-check": {
      "mode": "review-committee",
      "candidates": {
        "review-technical": [
          "kimi",
          "qwen-max"
        ],
        "review-skeptic": [
          "deepseek-pro"
        ],
        "review-systems": [
          "glm"
        ],
        "judge": [
          "deepseek-pro"
        ],
        "review-synth": [
          "kimi",
          "qwen-max"
        ]
      },
      "fileAgent": false,
      "verify": [
        {
          "state": "{{synthesis}}",
          "questions": {
            "addresses_question": {
              "type": "noul",
              "instructions": "The answer directly addresses the question that was asked.",
              "criteria": {
                "true": "Answers the actual question",
                "false": "Answers a different or narrower question"
              },
              "warnBelow": 0.35
            },
            "grounded_in_panel": {
              "type": "noul",
              "instructions": "Every substantive claim traces to the expert responses or the judge analysis.",
              "criteria": {
                "true": "All claims traceable",
                "false": "Contains claims with no support in the deliberation"
              }
            },
            "contradiction_handling": {
              "type": "choice",
              "instructions": "How the answer handles the judge's contradictions.",
              "criteria": {
                "resolves": "Picks a side and says why",
                "acknowledges": "Notes the disagreement without choosing",
                "ignores": "Does not mention it"
              }
            }
          }
        }
      ],
      "execute": false
    },
    "review-quick": {
      "name": "Review · quick (one skeptic)",
      "mode": "review-single",
      "execute": false,
      "thinking": {
        "review-skeptic": "low",
        "review-synth": "low"
      },
      "candidates": {
        "review-skeptic": [
          "deepseek-pro"
        ],
        "review-synth": [
          "deepseek-pro"
        ]
      },
      "fileAgent": false,
      "verify": [
        {
          "state": "{{synthesis}}",
          "questions": {
            "addresses_question": {
              "type": "noul",
              "instructions": "The review states whether the diff meets the acceptance criteria it was written against, rather than describing the diff.",
              "criteria": {
                "true": "Judges the change against its criteria",
                "false": "Describes the diff or answers a different question"
              },
              "warnBelow": 0.35
            }
          }
        }
      ]
    },
    "smrt-review": {
      "name": "Review · routed by blast radius",
      "mode": "review-committee",
      "review": true,
      "execute": false,
      "thinking": {
        "review-technical": "medium",
        "review-skeptic": "medium",
        "review-systems": "medium",
        "judge": "high",
        "review-synth": "high"
      },
      "candidates": {
        "review-technical": [
          "qwen-max",
          "kimi"
        ],
        "review-skeptic": [
          "glm",
          "deepseek-pro"
        ],
        "review-systems": [
          "deepseek-pro"
        ],
        "judge": [
          "kimi"
        ],
        "review-synth": [
          "qwen-max"
        ]
      },
      "fileAgent": false,
      "verify": [
        {
          "state": "{{synthesis}}",
          "questions": {
            "addresses_question": {
              "type": "noul",
              "instructions": "The review states whether the diff meets the acceptance criteria it was written against, rather than describing the diff.",
              "criteria": {
                "true": "Judges the change against its criteria",
                "false": "Describes the diff or answers a different question"
              },
              "warnBelow": 0.35
            },
            "grounded_in_panel": {
              "type": "noul",
              "instructions": "Every finding traces to something in the packet or the panel, not to a guess about code nobody read.",
              "criteria": {
                "true": "All findings traceable",
                "false": "Contains findings with no support in the packet"
              }
            },
            "boundary_handled": {
              "type": "noul",
              "instructions": "The review considered irreversible or boundary-crossing effects — authentication, authorization, tenancy, data, release — rather than only local behaviour.",
              "criteria": {
                "true": "Boundaries considered",
                "false": "Only local behaviour considered"
              }
            }
          }
        }
      ],
      "route": {
        "instructions": "How much review does this change need? Judge the blast radius of the diff — what it can affect if it is wrong — not how many lines it moves, and prefer the cheapest review that can carry it. Answer `high` when you are unsure.",
        "criteria": {
          "mechanical": {
            "description": "Docs, comments, formatting, or a configuration value, with no behaviour change — and nothing a test or a script could catch instead.",
            "then": "review-quick"
          },
          "standard": {
            "description": "An ordinary behaviour change: code that runs, tests, or user-visible output, contained within one component.",
            "then": "review-check"
          },
          "high": {
            "description": "A boundary: authentication, authorization, tenancy, payments, a schema or data migration, a public API contract, release or lifecycle tooling, anything irreversible, or any change whose blast radius you cannot bound from the packet."
          }
        },
        "sufficientWhen": {
          "minConfidence": 0.6
        }
      }
    }
  },
  "decide": {
    "defaultBackend": "typesafe",
    "models": {
      "qwen3.5-4b": {
        "source": "Qwen/Qwen3.5-4B",
        "revision": "851bf6e806efd8d0a36b00ddf55e13ccb7b8cd0a"
      },
      "minicpm5-2b": {
        "source": "openbmb/MiniCPM5-2B",
        "revision": "12a3808a956f869c767195e9266b59c4d21d92e2"
      },
      "qwen3-0.6b": {
        "source": "Qwen/Qwen3-0.6B",
        "revision": "c1899de289a04d12100db370d81485cdf75e47ca"
      }
    }
  },
  "backends": {
    "typesafe": {
      "kind": "typesafe",
      "url": "https://api.typesafe.ai/v1/systemone",
      "apiKeyEnv": "TYPESAFE_API_KEY",
      "model": "jev-1.13.0",
      "timeoutMs": 60000
    },
    "semif": {
      "kind": "semif",
      "url": "http://127.0.0.1:8791/score",
      "timeoutMs": 30000,
      "model": "qwen3.5-4b"
    },
    "semif-hosted": {
      "kind": "semif",
      "url": "https://SET-THE-HOSTED-SEMIF-URL/score",
      "apiKeyEnv": "SEMIF_API_KEY",
      "timeoutMs": 30000,
      "model": "qwen3.5-4b"
    },
    "semif-stub": {
      "kind": "semif",
      "url": "http://127.0.0.1:8792/score",
      "timeoutMs": 5000,
      "model": "qwen3.5-4b"
    }
  }
}
