{
  "providerId": "fusion-matrix",
  "providerName": "Fusion Matrix",
  "defaultFusion": "smart",
  "aliases": {
    "glm": {
      "model": "glm-5.3",
      "providers": [
        "opencode-go",
        "zai"
      ]
    },
    "qwen-max": {
      "model": "qwen3.8-max",
      "providers": [
        "opencode-go"
      ]
    },
    "deepseek-flash": {
      "model": "deepseek-v4.1-flash",
      "contextWindow": 1000000,
      "maxTokens": 384000,
      "providers": [
        "opencode-go"
      ]
    },
    "mimo-flash": {
      "model": "mimo-v2.6-flash",
      "contextWindow": 1000000,
      "maxTokens": 131072,
      "providers": [
        "opencode-go"
      ]
    },
    "mimo": {
      "model": "mimo-v2.6-pro",
      "contextWindow": 1000000,
      "maxTokens": 131072,
      "providers": [
        "opencode-go"
      ]
    }
  },
  "personas": {
    "technical": {
      "prompt": "prompts/technical.md",
      "temperature": 0.5,
      "thinking": "medium"
    },
    "skeptic": {
      "prompt": "prompts/skeptic.md",
      "temperature": 0.8
    },
    "systems": {
      "prompt": "prompts/systems.md",
      "temperature": 0.6
    },
    "judge": {
      "prompt": "prompts/judge.md",
      "temperature": 0.2,
      "output": "json"
    },
    "synth": {
      "prompt": "prompts/synth.md",
      "temperature": 0.5
    },
    "review-synth": {
      "prompt": "prompts/review-synth.md",
      "temperature": 0.3,
      "output": "json"
    },
    "merge": {
      "prompt": "prompts/merge.md",
      "temperature": 0.4
    },
    "review-skeptic": {
      "prompt": "prompts/review-skeptic.md",
      "temperature": 0.8,
      "output": "json"
    },
    "review-technical": {
      "prompt": "prompts/review-technical.md",
      "temperature": 0.5,
      "thinking": "medium",
      "output": "json"
    },
    "review-systems": {
      "prompt": "prompts/review-systems.md",
      "temperature": 0.6,
      "output": "json"
    }
  },
  "modes": {
    "single": {
      "stages": [
        {
          "single": "technical",
          "input": "prompt"
        }
      ]
    },
    "handoff": {
      "stages": [
        {
          "single": "technical",
          "input": "prompt"
        },
        {
          "single": "synth",
          "input": "previous",
          "alsoSynthesize": true
        }
      ]
    },
    "pair": {
      "stages": [
        {
          "parallel": [
            "technical",
            "skeptic"
          ],
          "input": "prompt"
        },
        {
          "single": "merge",
          "input": "panel"
        }
      ]
    },
    "committee": {
      "stages": [
        {
          "parallel": [
            "technical",
            "skeptic",
            "systems"
          ],
          "input": "prompt"
        },
        {
          "single": "judge",
          "input": "panel"
        },
        {
          "single": "synth",
          "input": "panel+judge"
        }
      ]
    },
    "review-committee": {
      "stages": [
        {
          "parallel": [
            "review-technical",
            "review-skeptic",
            "review-systems"
          ],
          "input": "prompt"
        },
        {
          "decide": {
            "instructions": "Do the reviewers agree on the same material findings?",
            "criteria": {
              "agrees": "They converge on the same findings and the same severity.",
              "partial": "They overlap but differ on a substantive finding or its severity.",
              "disagrees": "They report materially different findings."
            }
          },
          "input": "panel",
          "sufficientWhen": {
            "choiceIs": [
              "agrees"
            ],
            "minConfidence": 0.85
          }
        },
        {
          "single": "judge",
          "input": "panel"
        },
        {
          "single": "review-synth",
          "input": "panel+judge"
        }
      ]
    }
  },
  "fusions": {
    "cheap": {
      "name": "Cheap · deepseek flash",
      "mode": "single",
      "thinking": {
        "technical": "low"
      },
      "candidates": {
        "technical": [
          "deepseek-flash"
        ]
      },
      "fileAgent": false
    },
    "good": {
      "name": "Good · flash works, MiMo-flash takes over",
      "mode": "handoff",
      "thinking": {
        "technical": "low",
        "synth": "high"
      },
      "candidates": {
        "technical": [
          "deepseek-flash"
        ],
        "synth": [
          "mimo-flash"
        ]
      },
      "fileAgent": false
    },
    "smart": {
      "name": "Smart · flash works, mimo takes over",
      "mode": "handoff",
      "thinking": {
        "technical": "low",
        "synth": "high"
      },
      "candidates": {
        "technical": [
          "deepseek-flash"
        ],
        "synth": [
          "mimo"
        ]
      },
      "fileAgent": false
    },
    "genius": {
      "name": "Genius · glm + qwen-max → mimo synthesis",
      "mode": "pair",
      "candidates": {
        "technical": [
          "glm"
        ],
        "skeptic": [
          "qwen-max"
        ],
        "merge": [
          "mimo"
        ]
      },
      "fileAgent": false
    },
    "plan": {
      "name": "Plan · mimo + glm + qwen-max → mimo synthesis",
      "mode": "committee",
      "candidates": {
        "technical": [
          "mimo"
        ],
        "skeptic": [
          "glm"
        ],
        "systems": [
          "qwen-max"
        ],
        "judge": [
          "mimo"
        ],
        "synth": [
          "mimo"
        ]
      },
      "fileAgent": false
    },
    "review-check": {
      "mode": "review-committee",
      "disposition": {
        "personas": [
          "review-technical",
          "review-skeptic",
          "review-systems",
          "review-synth"
        ]
      },
      "candidates": {
        "review-technical": [
          "mimo"
        ],
        "review-skeptic": [
          "glm"
        ],
        "review-systems": [
          "qwen-max"
        ],
        "judge": [
          "mimo"
        ],
        "review-synth": [
          "mimo"
        ]
      },
      "fileAgent": false,
      "verify": [
        {
          "state": "{{synthesis}}",
          "questions": {
            "addresses_question": {
              "type": "noul",
              "instructions": "The answer directly addresses the question that was asked.",
              "criteria": {
                "true": "Answers the actual question",
                "false": "Answers a different or narrower question"
              },
              "warnBelow": 0.35
            },
            "grounded_in_panel": {
              "type": "noul",
              "instructions": "Every substantive claim traces to the expert responses or the judge analysis.",
              "criteria": {
                "true": "All claims traceable",
                "false": "Contains claims with no support in the deliberation"
              }
            },
            "engages_disagreement": {
              "type": "noul",
              "instructions": "The answer engages with the judge's contradictions: it resolves them, or says why it cannot, rather than passing over them.",
              "criteria": {
                "true": "Resolves the disagreement, or names it and says why it stands",
                "false": "Passes over the disagreement"
              },
              "warnBelow": 0.35
            }
          }
        }
      ],
      "execute": false
    }
  },
  "decide": {
    "defaultBackend": "typesafe",
    "models": {
      "qwen3.5-4b": {
        "source": "Qwen/Qwen3.5-4B",
        "revision": "851bf6e806efd8d0a36b00ddf55e13ccb7b8cd0a"
      },
      "minicpm5-2b": {
        "source": "openbmb/MiniCPM5-2B",
        "revision": "12a3808a956f869c767195e9266b59c4d21d92e2"
      },
      "qwen3-0.6b": {
        "source": "Qwen/Qwen3-0.6B",
        "revision": "c1899de289a04d12100db370d81485cdf75e47ca"
      }
    }
  },
  "backends": {
    "typesafe": {
      "kind": "typesafe",
      "url": "https://api.typesafe.ai/v1/systemone",
      "apiKeyEnv": "TYPESAFE_API_KEY",
      "model": "jev-1.13.0",
      "timeoutMs": 60000
    },
    "semif": {
      "kind": "semif",
      "url": "http://127.0.0.1:8791/score",
      "timeoutMs": 30000,
      "model": "qwen3.5-4b"
    },
    "semif-hosted": {
      "kind": "semif",
      "url": "https://SET-THE-HOSTED-SEMIF-URL/score",
      "apiKeyEnv": "SEMIF_API_KEY",
      "timeoutMs": 30000,
      "model": "qwen3.5-4b"
    },
    "semif-stub": {
      "kind": "semif",
      "url": "http://127.0.0.1:8792/score",
      "timeoutMs": 5000,
      "model": "qwen3.5-4b"
    }
  }
}
